ze=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="110" height="70" as="geometry"/></mxCell><mxCell id="t-ops" value="Equipo de&lt;br&gt;Operaciones" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="905" width="110" height="70" as="geometry"/></mxCell><mxCell id="t-armor" value='&lt;b&gt;Cloud LB + Cloud Armor&lt;/b&gt; &lt;font color="#2E7D32"&gt;[NUEVO]&lt;/font&gt;&lt;br&gt;&lt;i&gt;Perímetro&lt;/i&gt;&lt;br&gt;• WAF OWASP&lt;br&gt;• Rate limit por usuario/IP en /disbursements&lt;br&gt;• TLS 1.2+' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="160" y="225" width="180" height="120" as="geometry"/></mxCell><mxCell id="t-pops" value="&lt;b&gt;Proxy&lt;/b&gt;&lt;br&gt;&lt;i&gt;interseguro.pe/ADMWR&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#1E88E5;" vertex="1" parent="1"><mxGeometry x="160" y="905" width="170" height="70" as="geometry"/></mxCell><mxCell id="t-fe" value='&lt;b&gt;zona-segura-frontend&lt;/b&gt; &lt;font color="#EF6C00"&gt;[MOD]&lt;/font&gt;&lt;br&gt;&lt;i&gt;Cloud Run · Vue&lt;/i&gt;&lt;br&gt;• Genera Idempotency-Key (UUID) por intención y la persiste&lt;br&gt;• Botón deshabilitado al enviar&lt;br&gt;• Muestra «En proceso» y consulta estado' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFF3E0;strokeColor=#EF6C00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="105" width="180" height="140" as="geometry"/></mxCell><mxCell id="t-be" value='&lt;b&gt;zona-segura-backend&lt;/b&gt; &lt;font color="#EF6C00"&gt;[MOD]&lt;/font&gt;&lt;br&gt;&lt;i&gt;Cloud Run · Node&lt;/i&gt;&lt;br&gt;• POST /v1/disbursements → 202&lt;br&gt;• GET /v1/disbursements/{id}&lt;br&gt;• Clave repetida → mismo requestId&lt;br&gt;• Ya no llama a INARI' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFF3E0;strokeColor=#EF6C00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="105" width="200" height="140" as="geometry"/></mxCell><mxCell id="t-relay" value='&lt;b&gt;outbox-relay&lt;/b&gt; &lt;font color="#2E7D32"&gt;[NUEVO]&lt;/font&gt;&lt;br&gt;&lt;i&gt;Cloud Run · Mongo Change Streams&lt;/i&gt;&lt;br&gt;• Publica el outbox (at-least-once)&lt;br&gt;• Marca publicado tras ack' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="970" y="105" width="240" height="110" as="geometry"/></mxCell><mxCell id="t-sec" value='&lt;b&gt;Plataforma&lt;/b&gt; &lt;font color="#2E7D32"&gt;[NUEVO]&lt;/font&gt;&lt;br&gt;&lt;i&gt;Secret Manager · Cloud Logging/Monitoring/Trace&lt;/i&gt;&lt;br&gt;• correlationId = idempotencyKey&lt;br&gt;• Alertas: DLQ &gt; 0, PROCESSING &gt; 10 min' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="290" width="180" height="130" as="geometry"/></mxCell><mxCell id="t-db" value='&lt;b&gt;portal-db&lt;/b&gt; &lt;font color="#EF6C00"&gt;[MOD]&lt;/font&gt;&lt;br&gt;&lt;i&gt;MongoDB (replica set)&lt;/i&gt;&lt;br&gt;• loan_requests: UNIQUE(idempotencyKey)&lt;br&gt;• UNIQUE parcial (policyId) si estado ∈ {PENDING, PROCESSING}&lt;br&gt;• campo version (CAS)&lt;br&gt;• outbox en la misma transacción' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFF3E0;strokeColor=#EF6C00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="280" width="200" height="150" as="geometry"/></mxCell><mxCell id="t-topic" value='&lt;b&gt;loan-disbursement-requested&lt;/b&gt; &lt;font color="#2E7D32"&gt;[NUEVO]&lt;/font&gt;&lt;br&gt;&lt;i&gt;Pub/Sub&lt;/i&gt;&lt;br&gt;• orderingKey = policyId&lt;br&gt;• exactly-once delivery&lt;br&gt;• maxDeliveryAttempts = 5 → DLQ' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="970" y="280" width="240" height="110" as="geometry"/></mxCell><mxCell id="t-notif" value='&lt;b&gt;disbursement-notifier&lt;/b&gt; &lt;font color="#2E7D32"&gt;[NUEVO]&lt;/font&gt;&lt;br&gt;&lt;i&gt;Cloud Run · topic loan-disbursement-status&lt;/i&gt;&lt;br&gt;• Email / push al cliente con el resultado' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="460" width="180" height="110" as="geometry"/></mxCell><mxCell id="t-worker" value='&lt;b&gt;disbursement-worker&lt;/b&gt; &lt;font color="#2E7D32"&gt;[NUEVO]&lt;/font&gt;&lt;br&gt;&lt;i&gt;Cloud Run · concurrency=1 · max-instances=3&lt;/i&gt;&lt;br&gt;• CAS PENDING→PROCESSING (un solo worker)&lt;br&gt;• Circuit breaker + backoff exponencial con jitter&lt;br&gt;• Timeout/5xx: consulta estado por clave antes de reintentar' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="970" y="440" width="240" height="140" as="geometry"/></mxCell><mxCell id="t-dlq" value='&lt;b&gt;loan-disbursement-dlq&lt;/b&gt; &lt;font color="#2E7D32"&gt;[NUEVO]&lt;/font&gt;&lt;br&gt;&lt;i&gt;Pub/Sub · dead letter&lt;/i&gt;&lt;br&gt;• Revisión manual de Operaciones' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="590" width="200" height="70" as="geometry"/></mxCell><mxCell id="t-csql" value="&lt;b&gt;is-caoi-interface-ultimus&lt;/b&gt;&lt;br&gt;&lt;i&gt;Cloud SQL&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#1E88E5;" vertex="1" parent="1"><mxGeometry x="1310" y="90" width="190" height="70" as="geometry"/></mxCell><mxCell id="t-sched" value='&lt;b&gt;Cloud Scheduler&lt;/b&gt; &lt;font color="#2E7D32"&gt;[NUEVO]&lt;/font&gt;&lt;br&gt;&lt;i&gt;cada 10 min / diario&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1310" y="300" width="190" height="70" as="geometry"/></mxCell><mxCell id="t-recon" value='&lt;b&gt;reconciliation-job&lt;/b&gt; &lt;font color="#2E7D32"&gt;[NUEVO]&lt;/font&gt;&lt;br&gt;&lt;i&gt;Cloud Run Job&lt;/i&gt;&lt;br&gt;• PROCESSING &gt; N min → consulta admwr por clave y corrige el estado&lt;br&gt;• Cuadre diario solicitudes vs desembolsos: alerta si hay duplicados' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1310" y="450" width="190" height="170" as="geometry"/></mxCell><mxCell id="t-band" value="Serverless VPC Access → Cloud VPN / Interconnect  ·  mTLS + allowlist de IP  ·  solo el worker y el job llegan a INARI" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;dashed=1;fontSize=12;fontStyle=1;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="360" y="715" width="1160" height="40" as="geometry"/></mxCell><mxCell id="t-forms" value="&lt;b&gt;ADMWR&lt;/b&gt;&lt;br&gt;&lt;i&gt;.NET Forms&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#1E88E5;" vertex="1" parent="1"><mxGeometry x="400" y="900" width="170" height="70" as="geometry"/></mxCell><mxCell id="t-admwr" value='&lt;b&gt;admwr-api&lt;/b&gt; &lt;font color="#EF6C00"&gt;[MOD]&lt;/font&gt;&lt;br&gt;&lt;i&gt;poolAdmwrApi · IDEMPOTENTE&lt;/i&gt;&lt;br&gt;• Header Idempotency-Key obligatorio&lt;br&gt;• INSERT disbursement_request (UNIQUE key) en la MISMA transacción que registra el préstamo&lt;br&gt;• Clave repetida → devuelve el resultado guardado, no re-ejecuta&lt;br&gt;• GET /loans/by-key/{key} para conciliación' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFF3E0;strokeColor=#EF6C00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="620" y="850" width="400" height="140" as="geometry"/></mxCell><mxCell id="t-ultapi" value="&lt;b&gt;ultimus-api&lt;/b&gt;&lt;br&gt;&lt;i&gt;poolUltimusApi&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#1E88E5;" vertex="1" parent="1"><mxGeometry x="620" y="1050" width="400" height="70" as="geometry"/></mxCell><mxCell id="t-sql" value='&lt;b&gt;admwr&lt;/b&gt; &lt;font color="#EF6C00"&gt;[MOD]&lt;/font&gt;&lt;br&gt;&lt;i&gt;SQL Server&lt;/i&gt;&lt;br&gt;• préstamos + disbursement_request(idempotency_key UNIQUE, policy, status, loan_id, created_at)' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFF3E0;strokeColor=#EF6C00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1060" y="855" width="420" height="100" as="geometry"/></mxCell><mxCell id="t-sftpn" value="&lt;b&gt;SFTP_ASBANC&lt;/b&gt;&lt;br&gt;&lt;i&gt;Carpeta compartida&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#1E88E5;" vertex="1" parent="1"><mxGeometry x="1180" y="1095" width="200" height="55" as="geometry"/></mxCell><mxCell id="t-exa" value="&lt;b&gt;EXACTUS&lt;/b&gt;&lt;br&gt;&lt;i&gt;SaaS&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#1E88E5;" vertex="1" parent="1"><mxGeometry x="1580" y="905" width="170" height="60" as="geometry"/></mxCell><mxCell id="t-ult" value="&lt;b&gt;ULTIMUS&lt;/b&gt;&lt;br&gt;&lt;i&gt;SaaS&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#1E88E5;" vertex="1" parent="1"><mxGeometry x="1580" y="1055" width="170" height="60" as="geometry"/></mxCell><mxCell id="t-banks" value="&lt;b&gt;SFTP bancos&lt;/b&gt;&lt;br&gt;&lt;i&gt;BBVA · BCP · IBK · SCOTIA&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#1E88E5;" vertex="1" parent="1"><mxGeometry x="1580" y="1125" width="170" height="50" as="geometry"/></mxCell><mxCell id="t-legend" value='&lt;b&gt;Cómo se elimina la duplicidad (defensa en profundidad)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Capa 1 · Frontend:&lt;/b&gt; una Idempotency-Key por intención de préstamo, persistida (sessionStorage); reintentos y refresh reutilizan la misma clave.&lt;br&gt;• &lt;b&gt;Capa 2 · portal-db:&lt;/b&gt; índice UNIQUE sobre la clave (misma clave = misma solicitud) + índice UNIQUE parcial por póliza activa (doble pestaña o doble clic con claves distintas → 409 con la solicitud vigente).&lt;br&gt;• &lt;b&gt;Capa 3 · admwr (TAURO):&lt;/b&gt; UNIQUE(idempotency_key) en la misma transacción que el préstamo. Aunque el worker reintente o Pub/Sub entregue dos veces, SQL Server rechaza el segundo insert.&lt;br&gt;• &lt;b&gt;Reintentos seguros:&lt;/b&gt; ante timeout el worker primero consulta GET /loans/by-key; solo reintenta si el préstamo no existe. Los estados inciertos los cierra el job de conciliación.&lt;br&gt;• &lt;b&gt;Concurrencia:&lt;/b&gt; CAS sobre version (PENDING→PROCESSING), orderingKey por póliza y worker con concurrency=1 / max-instances=3 → como máximo 3 llamadas simultáneas a INARI (protege su latencia).&lt;br&gt;• &lt;b&gt;Experiencia:&lt;/b&gt; el cliente recibe 202 en &amp;lt; 300 ms con «Solicitud recibida, en proceso»; ya no ve 502. El resultado llega por la pantalla de estado y por email/push.&lt;br&gt;&lt;br&gt;&lt;b&gt;Leyenda:&lt;/b&gt; &lt;font color="#2E7D32"&gt;■ NUEVO&lt;/font&gt; &amp;nbsp; &lt;font color="#EF6C00"&gt;■ MODIFICADO&lt;/font&gt; &amp;nbsp; &lt;font color="#1E88E5"&gt;■ existente&lt;/font&gt; &amp;nbsp; &lt;font color="#1E88E5"&gt;→ síncrono&lt;/font&gt; &amp;nbsp; &lt;font color="#2E7D32"&gt;→ asíncrono&lt;/font&gt; &amp;nbsp; &lt;font color="#546E7A"&gt;⇢ respuesta/consulta&lt;/font&gt; &amp;nbsp; &lt;font color="#C62828"&gt;⇢ error&lt;/font&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#90A4AE;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1215" width="1760" height="245" as="geometry"/></mxCell><mxCell id="p1-e0" value="1. Solicitar préstamo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1E88E5;strokeWidth=1.5;" edge="1" parent="1" source="t-cli" target="t-armor"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1E88E5;strokeWidth=1.5;" edge="1" parent="1" source="t-armor" target="t-fe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e2" value="2. POST&#10;(Idempotency-Key)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1E88E5;strokeWidth=1.5;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="t-fe" target="t-be"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e3" value="4. 202 Accepted&#10;11. GET estado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#546E7A;dashed=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="t-be" target="t-fe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e4" value="3. TX: PENDING + outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1E88E5;strokeWidth=1.5;" edge="1" parent="1" source="t-be" target="t-db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e5" value="5. change stream" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="t-db" target="t-relay"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="935" y="325"/><mxPoint x="935" y="171"/></Array></mxGeometry></mxCell><mxCell id="p1-e6" value="6. publica" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;" edge="1" parent="1" source="t-relay" target="t-topic"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;" edge="1" parent="1" source="t-topic" target="t-worker"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e8" value="8. CAS → PROCESSING&#10