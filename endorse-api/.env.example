NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://localhost:5432/endorse_db
DB_SSL=false
DB_RUN_MIGRATIONS=false
# Mínimo 32 caracteres. En producción se inyecta desde Secret Manager.
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
JWT_ISSUER=endorse-api
JWT_AUDIENCE=endorse-clients
JWT_TTL_SECONDS=3600
AUTH_CLIENT_ID=frontend-demo
AUTH_CLIENT_SECRET=frontend-demo-secret
CORS_ORIGINS=http://localhost:5173
