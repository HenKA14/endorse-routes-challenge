{
  "name": "endorse-api",
  "version": "1.0.0",
  "description": "Servicio traductor de endosos (JSON plano -> JSON del core) basado en plantillas dinámicas en BD",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:prod": "node dist/database/migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:unit": "jest test/unit",
    "test:coverage": "jest --coverage"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@hapi/hapi": "^21.4.13",
    "@hapi/inert": "^7.1.3",
    "@hapi/jwt": "^3.2.4",
    "@hapi/vision": "^7.0.3",
    "hapi-swagger": "^17.3.2",
    "joi": "^17.13.9",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
